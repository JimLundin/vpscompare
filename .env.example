# VPS Compare - Provider API Keys
#
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# Then verify connectivity:
#   npm run check:providers
#
# Providers without valid keys will be silently skipped during build.
# Linode works without any API key.

# ────────────────────────────────────────
# Linode (no API key required)
# Public endpoints, works out of the box.
# ────────────────────────────────────────

# ────────────────────────────────────────
# DigitalOcean
# Get a read-only personal access token:
# https://cloud.digitalocean.com/account/api/tokens
# ────────────────────────────────────────
DIGITALOCEAN_API_KEY=

# ────────────────────────────────────────
# Hetzner Cloud
# Create an API token (read-only) in any project:
# https://console.hetzner.cloud/ → Select project → Security → API Tokens
# ────────────────────────────────────────
HETZNER_API_KEY=

# Include ARM-based servers (default: false)
HETZNER_INCLUDE_ARM=false

# ────────────────────────────────────────
# Vultr
# Create an API key (enable only "subscriptions" scope for read-only):
# https://my.vultr.com/settings/#settingsapi
# ────────────────────────────────────────
VULTR_API_KEY=

# ────────────────────────────────────────
# UpCloud
# Create a sub-account with API access:
# https://hub.upcloud.com/account → Sub-accounts
# ────────────────────────────────────────
UPCLOUD_USERNAME=
UPCLOUD_PASSWORD=

# ────────────────────────────────────────
# Scaleway
# Generate an API key (secret key):
# https://console.scaleway.com/project/credentials
# ────────────────────────────────────────
SCALEWAY_API_KEY=
